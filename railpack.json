{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "20.19.0"
  },
  "steps": {
    "install": {
      "commands": [
        "npm install --legacy-peer-deps --no-audit --no-fund --include=dev"
      ]
    },
    "build": {
      "inputs": [
        { "step": "install" }
      ],
      "commands": [
        "npm run build"
      ]
    }
  },
  "deploy": {
    "startCommand": "npm start"
  }
}
